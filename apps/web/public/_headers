# Cabeceras de la web en producción (Cloudflare Workers static assets).
# La app no carga nada de afuera: todo sale del mismo dominio.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Los archivos con hash en el nombre no cambian nunca.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker se revisa siempre, para que las actualizaciones lleguen.
/sw.js
  Cache-Control: no-cache
