{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "taxis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  // postgres.js usa los sockets TCP de Workers a través de nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENTORNO": "production"
  },
  // DATABASE_URL es un secreto: `wrangler secret put DATABASE_URL` en producción,
  // apps/api/.dev.vars en desarrollo (ver .env.example).
  // En desarrollo y pruebas, R2 e Images se simulan en local (no tocan la cuenta ni cuestan).
  "r2_buckets": [{ "binding": "COMPROBANTES", "bucket_name": "taxis-comprobantes" }],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "dev": { "port": 8787 }
}
