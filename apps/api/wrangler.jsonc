{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "taxis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  // node-postgres usa los sockets TCP de Workers a través de nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENTORNO": "production"
  },
  // DATABASE_URL es un secreto: `wrangler secret put DATABASE_URL` en producción,
  // apps/api/.dev.vars en desarrollo (ver .env.example).
  "observability": { "enabled": true },
  "dev": { "port": 8787 }
}
