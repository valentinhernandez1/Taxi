{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Producción: un solo Worker sirve la web (apps/web/dist) y la API (/api).
  // Mismo dominio, así la cookie de sesión funciona sin CORS.
  // Los archivos de la web los sirve Cloudflare sin ejecutar el Worker (gratis, no cuentan pedidos).
  "name": "taxis",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENTORNO": "production"
  },
  // DATABASE_URL es un secreto: wrangler secret put DATABASE_URL -c wrangler.produccion.jsonc
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // El bucket se crea solo en el despliegue si no existe (hace falta R2 activado en la cuenta).
  // Images: plan gratis, 5.000 transformaciones distintas por mes; pasado eso no cobra, da error.
  "r2_buckets": [{ "binding": "COMPROBANTES", "bucket_name": "taxis-comprobantes" }],
  "images": { "binding": "IMAGES" },
  // Avisos al celular: una vez por día a las 8 de la mañana de Uruguay (11 UTC). Si no
  // están las claves VAPID, no hace nada. Plan gratis: hasta 5 cron por cuenta.
  "triggers": { "crons": ["0 11 * * *"] },
  "observability": { "enabled": true }
}
