# Desarrollo: copiá este archivo a .env (raíz) y a apps/api/.dev.vars.
# Nunca subas los valores reales al repositorio.

# Conexión a Postgres. Local: la de docker-compose. Producción: la cadena de Neon
# (se carga con `wrangler secret put DATABASE_URL`, no en un archivo).
DATABASE_URL=postgres://taxis:taxis@localhost:5432/taxis

# "development" permite la cookie de sesión sin Secure en http://localhost.
# En producción lo fija wrangler.jsonc ("production").
ENTORNO=development

# Solo para scripts/copia.sh: clave PÚBLICA de age (age1...).
# Generá el par con `age-keygen -o clave-copias.txt` y guardá la privada fuera del repo.
AGE_RECIPIENT=
