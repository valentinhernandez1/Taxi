{
  "name": "taxis-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @taxis/api --filter @taxis/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @taxis/api db:migrate",
    "db:generate": "pnpm --filter @taxis/api db:generate",
    "db:ejemplo": "pnpm --filter @taxis/api db:ejemplo",
    "dueno:crear": "pnpm --filter @taxis/api dueno:crear",
    "copia:probar": "scripts/probar-copia.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
